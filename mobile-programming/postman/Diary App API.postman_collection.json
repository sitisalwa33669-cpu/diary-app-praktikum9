          "mode": "raw",
          "raw": "{\n  \"title\": \"Belajar CRUD dan REST API\",\n  \"body\": \"Hari ini saya memahami alur CRUD pada aplikasi mobile.\",\n  \"mood\": \"😌\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"judul berubah\", () => pm.expect(pm.response.json().title).to.eql(\"Belajar CRUD dan REST API\"));"
            ]
          }
        }
      ]
    },
    {
