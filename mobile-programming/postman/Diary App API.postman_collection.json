{
  "info": {
    "name": "Diary App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"database connected\", () => pm.expect(pm.response.json().database).to.eql(\"connected\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 READ semua diary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/diaries",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "diaries"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 CREATE diary",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/diaries",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "diaries"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Belajar REST API\",\n  \"diary_date\": \"2026-11-24\",\n  \"body\": \"Hari ini saya belajar menghubungkan Express dan MySQL.\",\n  \"mood\": \"😄\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "const d = pm.response.json();",
              "pm.test(\"punya id\", () => pm.expect(d.id).to.be.a(\"number\"));",
              "pm.collectionVariables.set(\"diary_id\", d.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 READ satu diary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/diaries/{{diary_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "diaries",
            "{{diary_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"id sesuai\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"diary_id\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 UPDATE diary",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
